{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && ls -la && ls -la src && ls -la src/lib && cat src/lib/utils.* || true && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/auth/(.*)", "destination": "/api/index.py" },
    { "source": "/auth", "destination": "/api/index.py" },
    { "source": "/jobs/(.*)", "destination": "/api/index.py" },
    { "source": "/jobs", "destination": "/api/index.py" },
    { "source": "/mentor/(.*)", "destination": "/api/index.py" },
    { "source": "/resume/(.*)", "destination": "/api/index.py" },
    { "source": "/career/(.*)", "destination": "/api/index.py" },
    { "source": "/interview/(.*)", "destination": "/api/index.py" },
    { "source": "/test/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
