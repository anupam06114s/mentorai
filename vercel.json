{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api",
      "destination": { "service": "backend" }
    },
    {
      "source": "/auth/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/auth",
      "destination": { "service": "backend" }
    },
    {
      "source": "/jobs/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/jobs",
      "destination": { "service": "backend" }
    },
    {
      "source": "/mentor/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/resume/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/career/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/interview/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/test/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "backend" }
    },
    {
      "source": "/docs",
      "destination": { "service": "backend" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
